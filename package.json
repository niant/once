{
  "name": "once-css",
  "version": "1.0.0",
  "description": "Once CSS library",
  "scripts": {
    "build": "sass --no-source-map src/sass/main.scss dist/css/main.css && sass --no-source-map --style=compressed src/sass/main.scss dist/css/main.min.css",
    "dev": "sass --watch src/sass/main.scss:dist/css/main.css",
    "test": "npm run build && node --test",
    "prepack": "npm run build && node scripts/package.js prepare",
    "postpack": "node scripts/package.js clean",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "css/",
    "sass/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/niant/once.git"
  },
  "keywords": [
    "once",
    "css",
    "framework",
    "atomic",
    "oocss"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/niant/once/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "sass": "^1.104"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
