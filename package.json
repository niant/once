{
  "name": "once-css",
  "version": "1.0.0",
  "description": "Once CSS library",
  "scripts": {
    "test": "npm run build",
    "start": "npm run dev",
    "clean": "rm -rf dist",
    "sass": "sass src/sass/main.scss dist/css/main.css",
    "build-min": "sass --style=compressed src/sass/main.scss dist/css/main.min.css",
    "build": "npm run clean && npm run sass && npm run build-min",
    "watch": "sass --watch src/sass/main.scss:dist/css/main.css",
    "dev": "npm run clean && npm run watch"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/niant/once.git"
  },
  "keywords": [
    "once",
    "css",
    "framework",
    "atomic",
    "oocss"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/niant/once/issues"
  },
  "devDependencies": {
    "sass": "^1.104"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
