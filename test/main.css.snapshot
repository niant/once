"/*\n# Strip units from a number with units.\n\n```scss\n$number: strip-units(3px);\n```\n\nOutput:\n\n```scss\n$number => 3\n```\n\n */\n/*\n# Replace a string with another string\n\n```scss\n$output: str-replace('something here {might} change', '{might}', 'will');\n$output => 'something here will change'\n```\n\nOutput:\n\n```scss\n$output => 'something here will change'\n```\n\n */\n/*\n# CSS property generator with a specific properties\n\n```scss\n@include properties(( float: left, padding: 0 ));\n```\n\nOutput:\n\n```scss\nfloat: left;\npadding: 0;\n```\n\n */\n/*\n# CSS class generator with a specific name and properties\n\n```scss\n@include createSelector('Px-xs', ('padding-left': 1em, 'padding-right': 1em));\n```\n\nOutput:\n\n```scss\n.Px-xs {\n    padding-left: 1em;\n    padding-right: 1em;\n}\n```\n\n */\n/*\n# Generate multiple css classes according to values\n\n```scss\n@include createMultipleSelectors('f-{key}', ('white': #fff, 'black': #000), 'color');\n```\n\nOutput:\n\n```scss\n.f-white {\n    color: #fff;\n}\n```\n\n */\n/*\n# Generate multiple selectors (TBD)\n\n```scss\n$output: generateMultipleSelectors('Px', (xs, sm, md));\n```\n\nOutput\n\n```scss\n$output => (xs: 'Px-xs', sm: 'Px-sm', md: 'Px-md');\n```\n */\n/*\nmultipleDefinitions('f-{key}', (sm: 0.7em, md: 1.2em, lg: 2.5em), ('font-size'));\n\n/*\n(\n  f-sm: (font-size: 0.7em),\n  f-md: (font-size: 1.2em),\n  f-lg: (font-size: 2.5em)\n)\n*/\n/*\nCreate multiple class definitions in a map (multiplied by directions and another key/value map). For example:\n\n\n\n```sass\n$dirs: (t: (top), b: (bottom));\n$sizes: (sm: 0.5em, md: 1em);\n\ndirectionalDefinitions(\n  'P{dirKey}-{key}', $sizes, 'padding-{dir}', $dirs\n);\n\n// (\n//   Pt-sm: (padding-top: 0.5em),\n//   Pb-sm: (padding-bottom: 0.5em),\n//   Pt-md: (padding-top: 1em),\n//   Pb-md: (padding-bottom: 1em)\n// )\n\n```\n */\n/*\n# Create multiple sized classes\n\n```scss\n@include createMultipleSizeClasses('Px', (sm: 1em, md: 2em), ('padding-left', 'padding-right'));\n```\n\nOutput:\n\n```scss\n.Px-sm {\n    padding-left: 1em;\n    padding-right: 1em;\n}\n\n.Px-md {\n    padding-left: 2em;\n    padding-right: 2em;\n}\n```\n\n */\n/*\n# Create multiple sized box classes\n\nCreate CSS classes (multiple sizes) of elements that have top, right, bottom & left values\n\n```scss\n@include createMultipleSizeBoxClasses('P{dirKey}', (xs: 1em, sm: 2em), 'padding-{dir}');\n```\n\nWill generate for example following classes\n\n```scss\n.Pt-xs {\n    padding-top: 1em;\n}\n\n.Pt-sm {\n    padding-top: 2em;\n}\n\n.Py-xs {\n    padding-top: 1em;\n    padding-bottom: 1em;\n}\n\n...\n```\n */\n/*\n# Create multiple box classes\n\n```scss\n@include createMultipleBoxClasses('B{dirKey}-solid', ('border-{dir}-style': 'solid'));\n```\n\nWill generate for example following classes:\n\n```scss\n.Br-solid {\n    border-right-style: solid;\n}\n\n.Bx-solid {\n    border-right-style: solid;\n    border-left-style: solid;\n}\n\n...\n```\n\n */\n* {\n  box-sizing: border-box;\n}\n\n/* Flex classes */\n.flex {\n  display: flex;\n}\n\n.flex-align-start {\n  align-items: flex-start;\n}\n\n.flex-align-end {\n  align-items: flex-end;\n}\n\n.flex-align-center {\n  align-items: center;\n}\n\n.flex-align-baseline {\n  align-items: baseline;\n}\n\n.flex-align-stretch {\n  align-items: stretch;\n}\n\n.flex-align-inherit {\n  align-items: inherit;\n}\n\n.flex-align-initial {\n  align-items: initial;\n}\n\n.flex-justify-start {\n  justify-content: flex-start;\n}\n\n.flex-justify-end {\n  justify-content: flex-end;\n}\n\n.flex-justify-center {\n  justify-content: center;\n}\n\n.flex-justify-space-around {\n  justify-content: space-around;\n}\n\n.flex-justify-space-between {\n  justify-content: space-between;\n}\n\n.flex-justify-space-evently {\n  justify-content: space-evenly;\n}\n\n.flex-justify-initial {\n  justify-content: initial;\n}\n\n.flex-justify-inherit {\n  justify-content: inherit;\n}\n\n.flex-wrap-0 {\n  flex-wrap: nowrap;\n}\n\n.flex-wrap {\n  flex-wrap: wrap;\n}\n\n.flex-wrap-reverse {\n  flex-wrap: wrap-reverse;\n}\n\n.flex-wrap-inherit {\n  flex-wrap: inherit;\n}\n\n.flex-column {\n  flex-direction: column;\n}\n\n.flex-row {\n  flex-direction: row;\n}\n\n.flex-1 {\n  flex: 1;\n}\n\n.flex-2 {\n  flex: 2;\n}\n\n.flex-3 {\n  flex: 3;\n}\n\n.flex-4 {\n  flex: 4;\n}\n\n.flex-5 {\n  flex: 5;\n}\n\n/* Responsive flex classes */\n@media (min-width: 320px) {\n  .r-xs-flex {\n    display: flex;\n  }\n  .r-xs-flex-align-start {\n    align-items: flex-start;\n  }\n  .r-xs-flex-align-end {\n    align-items: flex-end;\n  }\n  .r-xs-flex-align-center {\n    align-items: center;\n  }\n  .r-xs-flex-align-baseline {\n    align-items: baseline;\n  }\n  .r-xs-flex-align-stretch {\n    align-items: stretch;\n  }\n  .r-xs-flex-align-inherit {\n    align-items: inherit;\n  }\n  .r-xs-flex-align-initial {\n    align-items: initial;\n  }\n  .r-xs-flex-justify-start {\n    justify-content: flex-start;\n  }\n  .r-xs-flex-justify-end {\n    justify-content: flex-end;\n  }\n  .r-xs-flex-justify-center {\n    justify-content: center;\n  }\n  .r-xs-flex-justify-space-around {\n    justify-content: space-around;\n  }\n  .r-xs-flex-justify-space-between {\n    justify-content: space-between;\n  }\n  .r-xs-flex-justify-space-evently {\n    justify-content: space-evenly;\n  }\n  .r-xs-flex-justify-initial {\n    justify-content: initial;\n  }\n  .r-xs-flex-justify-inherit {\n    justify-content: inherit;\n  }\n  .r-xs-flex-wrap-0 {\n    flex-wrap: nowrap;\n  }\n  .r-xs-flex-wrap {\n    flex-wrap: wrap;\n  }\n  .r-xs-flex-wrap-reverse {\n    flex-wrap: wrap-reverse;\n  }\n  .r-xs-flex-wrap-inherit {\n    flex-wrap: inherit;\n  }\n  .r-xs-flex-column {\n    flex-direction: column;\n  }\n  .r-xs-flex-row {\n    flex-direction: row;\n  }\n  .r-xs-flex-1 {\n    flex: 1;\n  }\n  .r-xs-flex-2 {\n    flex: 2;\n  }\n  .r-xs-flex-3 {\n    flex: 3;\n  }\n  .r-xs-flex-4 {\n    flex: 4;\n  }\n  .r-xs-flex-5 {\n    flex: 5;\n  }\n}\n@media (min-width: 640px) {\n  .r-sm-flex {\n    display: flex;\n  }\n  .r-sm-flex-align-start {\n    align-items: flex-start;\n  }\n  .r-sm-flex-align-end {\n    align-items: flex-end;\n  }\n  .r-sm-flex-align-center {\n    align-items: center;\n  }\n  .r-sm-flex-align-baseline {\n    align-items: baseline;\n  }\n  .r-sm-flex-align-stretch {\n    align-items: stretch;\n  }\n  .r-sm-flex-align-inherit {\n    align-items: inherit;\n  }\n  .r-sm-flex-align-initial {\n    align-items: initial;\n  }\n  .r-sm-flex-justify-start {\n    justify-content: flex-start;\n  }\n  .r-sm-flex-justify-end {\n    justify-content: flex-end;\n  }\n  .r-sm-flex-justify-center {\n    justify-content: center;\n  }\n  .r-sm-flex-justify-space-around {\n    justify-content: space-around;\n  }\n  .r-sm-flex-justify-space-between {\n    justify-content: space-between;\n  }\n  .r-sm-flex-justify-space-evently {\n    justify-content: space-evenly;\n  }\n  .r-sm-flex-justify-initial {\n    justify-content: initial;\n  }\n  .r-sm-flex-justify-inherit {\n    justify-content: inherit;\n  }\n  .r-sm-flex-wrap-0 {\n    flex-wrap: nowrap;\n  }\n  .r-sm-flex-wrap {\n    flex-wrap: wrap;\n  }\n  .r-sm-flex-wrap-reverse {\n    flex-wrap: wrap-reverse;\n  }\n  .r-sm-flex-wrap-inherit {\n    flex-wrap: inherit;\n  }\n  .r-sm-flex-column {\n    flex-direction: column;\n  }\n  .r-sm-flex-row {\n    flex-direction: row;\n  }\n  .r-sm-flex-1 {\n    flex: 1;\n  }\n  .r-sm-flex-2 {\n    flex: 2;\n  }\n  .r-sm-flex-3 {\n    flex: 3;\n  }\n  .r-sm-flex-4 {\n    flex: 4;\n  }\n  .r-sm-flex-5 {\n    flex: 5;\n  }\n}\n@media (min-width: 1024px) {\n  .r-md-flex {\n    display: flex;\n  }\n  .r-md-flex-align-start {\n    align-items: flex-start;\n  }\n  .r-md-flex-align-end {\n    align-items: flex-end;\n  }\n  .r-md-flex-align-center {\n    align-items: center;\n  }\n  .r-md-flex-align-baseline {\n    align-items: baseline;\n  }\n  .r-md-flex-align-stretch {\n    align-items: stretch;\n  }\n  .r-md-flex-align-inherit {\n    align-items: inherit;\n  }\n  .r-md-flex-align-initial {\n    align-items: initial;\n  }\n  .r-md-flex-justify-start {\n    justify-content: flex-start;\n  }\n  .r-md-flex-justify-end {\n    justify-content: flex-end;\n  }\n  .r-md-flex-justify-center {\n    justify-content: center;\n  }\n  .r-md-flex-justify-space-around {\n    justify-content: space-around;\n  }\n  .r-md-flex-justify-space-between {\n    justify-content: space-between;\n  }\n  .r-md-flex-justify-space-evently {\n    justify-content: space-evenly;\n  }\n  .r-md-flex-justify-initial {\n    justify-content: initial;\n  }\n  .r-md-flex-justify-inherit {\n    justify-content: inherit;\n  }\n  .r-md-flex-wrap-0 {\n    flex-wrap: nowrap;\n  }\n  .r-md-flex-wrap {\n    flex-wrap: wrap;\n  }\n  .r-md-flex-wrap-reverse {\n    flex-wrap: wrap-reverse;\n  }\n  .r-md-flex-wrap-inherit {\n    flex-wrap: inherit;\n  }\n  .r-md-flex-column {\n    flex-direction: column;\n  }\n  .r-md-flex-row {\n    flex-direction: row;\n  }\n  .r-md-flex-1 {\n    flex: 1;\n  }\n  .r-md-flex-2 {\n    flex: 2;\n  }\n  .r-md-flex-3 {\n    flex: 3;\n  }\n  .r-md-flex-4 {\n    flex: 4;\n  }\n  .r-md-flex-5 {\n    flex: 5;\n  }\n}\n@media (min-width: 1200px) {\n  .r-lg-flex {\n    display: flex;\n  }\n  .r-lg-flex-align-start {\n    align-items: flex-start;\n  }\n  .r-lg-flex-align-end {\n    align-items: flex-end;\n  }\n  .r-lg-flex-align-center {\n    align-items: center;\n  }\n  .r-lg-flex-align-baseline {\n    align-items: baseline;\n  }\n  .r-lg-flex-align-stretch {\n    align-items: stretch;\n  }\n  .r-lg-flex-align-inherit {\n    align-items: inherit;\n  }\n  .r-lg-flex-align-initial {\n    align-items: initial;\n  }\n  .r-lg-flex-justify-start {\n    justify-content: flex-start;\n  }\n  .r-lg-flex-justify-end {\n    justify-content: flex-end;\n  }\n  .r-lg-flex-justify-center {\n    justify-content: center;\n  }\n  .r-lg-flex-justify-space-around {\n    justify-content: space-around;\n  }\n  .r-lg-flex-justify-space-between {\n    justify-content: space-between;\n  }\n  .r-lg-flex-justify-space-evently {\n    justify-content: space-evenly;\n  }\n  .r-lg-flex-justify-initial {\n    justify-content: initial;\n  }\n  .r-lg-flex-justify-inherit {\n    justify-content: inherit;\n  }\n  .r-lg-flex-wrap-0 {\n    flex-wrap: nowrap;\n  }\n  .r-lg-flex-wrap {\n    flex-wrap: wrap;\n  }\n  .r-lg-flex-wrap-reverse {\n    flex-wrap: wrap-reverse;\n  }\n  .r-lg-flex-wrap-inherit {\n    flex-wrap: inherit;\n  }\n  .r-lg-flex-column {\n    flex-direction: column;\n  }\n  .r-lg-flex-row {\n    flex-direction: row;\n  }\n  .r-lg-flex-1 {\n    flex: 1;\n  }\n  .r-lg-flex-2 {\n    flex: 2;\n  }\n  .r-lg-flex-3 {\n    flex: 3;\n  }\n  .r-lg-flex-4 {\n    flex: 4;\n  }\n  .r-lg-flex-5 {\n    flex: 5;\n  }\n}\n@media (min-width: 320px) {\n  .xs-1 {\n    width: 8.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .xs-2 {\n    width: 16.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .xs-3 {\n    width: 25%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .xs-4 {\n    width: 33.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .xs-5 {\n    width: 41.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .xs-6 {\n    width: 50%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .xs-7 {\n    width: 58.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .xs-8 {\n    width: 66.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .xs-9 {\n    width: 75%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .xs-10 {\n    width: 83.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .xs-11 {\n    width: 91.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .xs-12 {\n    width: 100%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n}\n@media (min-width: 640px) {\n  .sm-1 {\n    width: 8.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .sm-2 {\n    width: 16.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .sm-3 {\n    width: 25%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .sm-4 {\n    width: 33.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .sm-5 {\n    width: 41.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .sm-6 {\n    width: 50%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .sm-7 {\n    width: 58.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .sm-8 {\n    width: 66.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .sm-9 {\n    width: 75%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .sm-10 {\n    width: 83.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .sm-11 {\n    width: 91.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .sm-12 {\n    width: 100%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n}\n@media (min-width: 1024px) {\n  .md-1 {\n    width: 8.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .md-2 {\n    width: 16.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .md-3 {\n    width: 25%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .md-4 {\n    width: 33.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .md-5 {\n    width: 41.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .md-6 {\n    width: 50%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .md-7 {\n    width: 58.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .md-8 {\n    width: 66.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .md-9 {\n    width: 75%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .md-10 {\n    width: 83.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .md-11 {\n    width: 91.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .md-12 {\n    width: 100%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n}\n@media (min-width: 1200px) {\n  .lg-1 {\n    width: 8.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .lg-2 {\n    width: 16.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .lg-3 {\n    width: 25%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .lg-4 {\n    width: 33.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .lg-5 {\n    width: 41.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .lg-6 {\n    width: 50%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .lg-7 {\n    width: 58.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .lg-8 {\n    width: 66.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .lg-9 {\n    width: 75%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .lg-10 {\n    width: 83.3333333333%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .lg-11 {\n    width: 91.6666666667%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n  .lg-12 {\n    width: 100%;\n    float: left;\n    height: 100%;\n    padding-left: 1rem;\n    padding-right: 1rem;\n  }\n}\n/*\n#Borders\n\nIn some countries they write from right to left so we decided to create start and end values for borders.\nThe value can be changed by changing the variable in a config file that is not created yet.\n\n* Bs = left or right border depending of the direction of writing\n* Bt = border-top\n* Br = border-right\n* Bb = border-bottom\n* Bl = border-left\n* Bx = border-left and border-right\n* By = border-top and border-bottom\n\n####No border top\n\n\t<div class=\"B-0\">There is no top border in this div.</div>\n*/\n.B-0 {\n  border: none;\n}\n\n.Bt-xs {\n  border-top-width: 1px;\n}\n\n.Bt-sm {\n  border-top-width: 2px;\n}\n\n.Bt-md {\n  border-top-width: 3px;\n}\n\n.Bt-lg {\n  border-top-width: 4px;\n}\n\n.Bt-xl {\n  border-top-width: 5px;\n}\n\n.Br-xs {\n  border-right-width: 1px;\n}\n\n.Br-sm {\n  border-right-width: 2px;\n}\n\n.Br-md {\n  border-right-width: 3px;\n}\n\n.Br-lg {\n  border-right-width: 4px;\n}\n\n.Br-xl {\n  border-right-width: 5px;\n}\n\n.Be-xs {\n  border-right-width: 1px;\n}\n\n.Be-sm {\n  border-right-width: 2px;\n}\n\n.Be-md {\n  border-right-width: 3px;\n}\n\n.Be-lg {\n  border-right-width: 4px;\n}\n\n.Be-xl {\n  border-right-width: 5px;\n}\n\n.Bb-xs {\n  border-bottom-width: 1px;\n}\n\n.Bb-sm {\n  border-bottom-width: 2px;\n}\n\n.Bb-md {\n  border-bottom-width: 3px;\n}\n\n.Bb-lg {\n  border-bottom-width: 4px;\n}\n\n.Bb-xl {\n  border-bottom-width: 5px;\n}\n\n.Bl-xs {\n  border-left-width: 1px;\n}\n\n.Bl-sm {\n  border-left-width: 2px;\n}\n\n.Bl-md {\n  border-left-width: 3px;\n}\n\n.Bl-lg {\n  border-left-width: 4px;\n}\n\n.Bl-xl {\n  border-left-width: 5px;\n}\n\n.Bs-xs {\n  border-left-width: 1px;\n}\n\n.Bs-sm {\n  border-left-width: 2px;\n}\n\n.Bs-md {\n  border-left-width: 3px;\n}\n\n.Bs-lg {\n  border-left-width: 4px;\n}\n\n.Bs-xl {\n  border-left-width: 5px;\n}\n\n.Bx-xs {\n  border-left-width: 1px;\n  border-right-width: 1px;\n}\n\n.Bx-sm {\n  border-left-width: 2px;\n  border-right-width: 2px;\n}\n\n.Bx-md {\n  border-left-width: 3px;\n  border-right-width: 3px;\n}\n\n.Bx-lg {\n  border-left-width: 4px;\n  border-right-width: 4px;\n}\n\n.Bx-xl {\n  border-left-width: 5px;\n  border-right-width: 5px;\n}\n\n.By-xs {\n  border-top-width: 1px;\n  border-bottom-width: 1px;\n}\n\n.By-sm {\n  border-top-width: 2px;\n  border-bottom-width: 2px;\n}\n\n.By-md {\n  border-top-width: 3px;\n  border-bottom-width: 3px;\n}\n\n.By-lg {\n  border-top-width: 4px;\n  border-bottom-width: 4px;\n}\n\n.By-xl {\n  border-top-width: 5px;\n  border-bottom-width: 5px;\n}\n\n.B-xs {\n  border-top-width: 1px;\n  border-right-width: 1px;\n  border-bottom-width: 1px;\n  border-left-width: 1px;\n}\n\n.B-sm {\n  border-top-width: 2px;\n  border-right-width: 2px;\n  border-bottom-width: 2px;\n  border-left-width: 2px;\n}\n\n.B-md {\n  border-top-width: 3px;\n  border-right-width: 3px;\n  border-bottom-width: 3px;\n  border-left-width: 3px;\n}\n\n.B-lg